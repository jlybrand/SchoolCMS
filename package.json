{
  "name": "dd2-website-platform",
  "version": "0.0.0",
  "private": true,
  "description": "District-owned, accessibility-native web platform serving 28 tenants (1 district + 27 schools) from one codebase.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --grep @a11y",
    "test:perf": "lhci autorun",
    "test:load": "echo 'k6 harness stub — see tests/load/README.md (Phase 8)' && exit 0",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "seed": "payload run scripts/seed.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:down": "payload migrate:down"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/plugin-multi-tenant": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "graphql": "16.14.2",
    "next": "16.3.0",
    "payload": "3.87.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "27.1.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
