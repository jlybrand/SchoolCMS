# Payload — payload-types.ts and importMap.js ARE committed.
# Types are generated from the schema (no DB needed), so committing them means typecheck
# works without a codegen step AND schema changes are visible in review. CI regenerates
# and fails on drift, so the committed copy can never go stale.

# Env — only .env.example is committed
.env
.env.*
!.env.example

