# =============================================================================
# DD2 Website Platform — environment contract
# =============================================================================
# Copy to `.env` for local development. NEVER commit `.env`.
# In every deployed environment these live in the platform secret store, never in
# the repository (`09` §1). Rotate on schedule and CALENDAR THE EXPIRY DATES —
# silent secret expiry is the most common avoidable outage in this stack (`09` §7).
#
# Legend:  [required]        must be set for the app to boot
#          [required@phase]  becomes required at that build phase (`05`)
#          [optional]        has a working default

# --- Core -------------------------------------------------------------------
# [required] Payload signing secret. Generate: openssl rand -base64 32
PAYLOAD_SECRET=change-me-locally-only

# [required] Postgres. Port 5433 matches docker-compose.yml, which deliberately
# avoids clashing with a system Postgres on 5432. Postgres, never Mongo (ADR-10).
DATABASE_URI=postgres://dd2:dd2_local_dev@localhost:5433/dd2

# [required] Public origin of the district apex tenant. Tenants are resolved from
# the request Host header against the `tenants` collection (`02` §4.1).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Authentication: Microsoft Entra ID (OIDC) ------------------ [required@1] -
# Separate app registration per environment. Non-production must NEVER authenticate
# against the production directory (`09` §1).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Entra group object IDs mapped to platform roles at login (`02` §7).
ENTRA_GROUP_DISTRICT_ADMIN=
ENTRA_GROUP_SCHOOL_MANAGER=

# --- Object storage: Cloudflare R2 ------------------------------ [required@6] -
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Cache invalidation: Cloudflare ----------------------------- [required@2] -
# Publish -> on-demand revalidate + targeted tag purge (`02` §5, `09` §4.2).
REVALIDATION_SECRET=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Translation: Azure AI Translator --------------------------- [required@7] -
# Engine is swappable; the pipeline depends on an interface, not on Azure (`08` §4).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=

# --- Transactional email: Resend -------------------------------- [required@4] -
# Approval notifications and system alerts ONLY. Mass communication is out of
# scope and runs on a separate district service (`01` §5).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- PowerSchool staff sync ------------------------------------- [required@5] -
# READ-ONLY, staff-scoped credential. Provision with the narrowest data access the
# district can grant — ideally scoped so student endpoints are not even reachable
# by the token (`11` §2, §8). NO STUDENT DATA, EVER.
POWERSCHOOL_BASE_URL=
POWERSCHOOL_CLIENT_ID=
POWERSCHOOL_CLIENT_SECRET=

# --- Observability ---------------------------------------------- [optional] ---
SENTRY_DSN=
